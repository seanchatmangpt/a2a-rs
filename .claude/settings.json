{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(ggen *)"
    ],
    "deny": [
      "Bash(cargo publish *)",
      "Read(.env*)",
      "Read(*.pem)",
      "Read(*credentials*)",
      "Read(*secret*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-init.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-bash.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-layers.sh"
          },
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'a2a-rs/src/generated/'; then echo '{\"decision\": \"block\", \"reason\": \"Files in a2a-rs/src/generated/ are auto-generated by ggen and must not be manually edited. Run ggen to regenerate them instead.\"}'; else echo '{\"decision\": \"allow\"}'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "async": true,
            "timeout": 120,
            "statusMessage": "Checking compilation..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'ggen/ontology/.*\\.ttl'; then rapper -i turtle \"$TOOL_INPUT_FILE_PATH\" -o /dev/null 2>&1 || echo 'TTL validation failed'; fi",
            "async": true,
            "timeout": 30,
            "statusMessage": "Validating TTL syntax..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Verify this task is complete. Read the changed files (use git diff). Check: 1) No unwrap()/expect() in library code 2) Public types have Serialize/Deserialize derives 3) cargo check passes. Context: $ARGUMENTS",
            "model": "haiku",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Check stop_hook_active in context - if true, respond {\"ok\": true}. Otherwise: 1) Was every user request addressed? 2) If .rs files were written, was cargo check/test run? Respond {\"ok\": true} or {\"ok\": false, \"reason\": \"...\"}. Context: $ARGUMENTS",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
