@prefix a2a: <https://a2a-rs.dev/ontology/ggen-optimizer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


a2a:construct-optimizer a skos:Concept ;
  skos:prefLabel "SPARQL CONSTRUCT optimizer" ;
  dcterms:description "Static analysis and rewriting for SPARQL CONSTRUCT queries." ;
  a2a:crate "ggen-optimizer" ;
  a2a:algorithmSurface "static-analysis|rewriting" ;
  a2a:authority "CONSTRUCT_ONLY" ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/a2a-rs/blob/05b88f81321d2a61556157e63180321acb661d53/ggen-optimizer/Cargo.toml> .


a2a:graph-analysis a skos:Concept ;
  skos:prefLabel "Optimizer graph analysis" ;
  dcterms:description "Graph-structure analysis used by the GGEN optimizer through petgraph." ;
  a2a:crate "ggen-optimizer" ;
  a2a:algorithmSurface "graph-analysis" ;
  a2a:authority "CONSTRUCT_ONLY" .


a2a:optimizer-property-tests a skos:Concept ;
  skos:prefLabel "Optimizer property-test surface" ;
  dcterms:description "Property-based falsification surface declared by the optimizer crate." ;
  a2a:crate "ggen-optimizer" ;
  a2a:algorithmSurface "proptest" ;
  a2a:authority "VERIFY_ONLY" .


a2a:crate a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
a2a:algorithmSurface a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
a2a:authority a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
