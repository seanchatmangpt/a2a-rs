---
output_file: conversions.rs
description: >
  Generates From and TryFrom trait implementations for type conversions
  between related A2A Protocol types. Identifies conversion relationships
  from the ontology (e.g., request params to domain types, enum variants
  to concrete types).
variables:
  conversions: >
    Array of conversion descriptors identifying source and target types,
    whether conversion is fallible (TryFrom) or infallible (From), and
    field mappings extracted from SPARQL CONSTRUCT results.
---
{# ============================================================================
   conversions.rs.tera
   ============================================================================
   Tera template for generating type conversion implementations.

   This template generates From/TryFrom trait implementations for converting
   between related types in the protocol, such as:
   - Request params -> domain types
   - Response results -> domain types
   - Enum variants -> concrete types
   - Protocol types -> internal types

   Expected context variables:
   - conversions: array of conversion descriptors, each containing:
       - source_type:      String  -- Source type name
       - target_type:      String  -- Target type name
       - is_fallible:      bool    -- true = TryFrom, false = From
       - description:      String? -- Documentation
       - field_mappings: array of field mappings, each with:
           - source_field: String  -- Field name in source type
           - target_field: String  -- Field name in target type
           - transform:    String? -- Optional transformation expression
           - required:     bool    -- Whether field is required
   ============================================================================
#}
//! Auto-generated type conversions for A2A Protocol types.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.
//!
//! Provides From/TryFrom implementations for converting between related
//! protocol types while maintaining type safety and validation.

use std::convert::TryFrom;

{% for conversion in conversions %}
{# --------------------------------------------------------------------------
   Doc comment for the conversion
   -------------------------------------------------------------------------- #}
{% if conversion.description %}
/// {{ conversion.description | split(pat="\n") | first }}
{% for line in conversion.description | split(pat="\n") %}
{% if not loop.first %}
/// {{ line }}
{% endif %}
{% endfor %}
{% else %}
/// Converts {{ conversion.source_type }} to {{ conversion.target_type }}.
{% endif %}
{% if conversion.is_fallible %}
{# --------------------------------------------------------------------------
   TryFrom implementation (fallible conversion)
   -------------------------------------------------------------------------- #}
impl TryFrom<{{ conversion.source_type }}> for {{ conversion.target_type }} {
    type Error = crate::domain::error::A2AError;

    fn try_from(source: {{ conversion.source_type }}) -> Result<Self, Self::Error> {
{% if conversion.field_mappings | length > 0 %}
        Ok(Self {
{% for mapping in conversion.field_mappings %}
{% if mapping.transform %}
            {{ mapping.target_field }}: {{ mapping.transform }}(source.{{ mapping.source_field }}){% if mapping.required %}.ok_or_else(|| {
                crate::domain::error::A2AError::InvalidInput {
                    message: format!("Missing required field: {{ mapping.target_field }}"),
                }
            })?{% endif %},
{% else %}
            {{ mapping.target_field }}: source.{{ mapping.source_field }}{% if mapping.required %}.ok_or_else(|| {
                crate::domain::error::A2AError::InvalidInput {
                    message: format!("Missing required field: {{ mapping.target_field }}"),
                }
            })?{% endif %},
{% endif %}
{% endfor %}
        })
{% else %}
        // Direct conversion with validation
        Ok({{ conversion.target_type }} {
            ..Default::default()
        })
{% endif %}
    }
}

{% else %}
{# --------------------------------------------------------------------------
   From implementation (infallible conversion)
   -------------------------------------------------------------------------- #}
impl From<{{ conversion.source_type }}> for {{ conversion.target_type }} {
    fn from(source: {{ conversion.source_type }}) -> Self {
{% if conversion.field_mappings | length > 0 %}
        Self {
{% for mapping in conversion.field_mappings %}
{% if mapping.transform %}
            {{ mapping.target_field }}: {{ mapping.transform }}(source.{{ mapping.source_field }}),
{% else %}
            {{ mapping.target_field }}: source.{{ mapping.source_field }},
{% endif %}
{% endfor %}
        }
{% else %}
        Self::default()
{% endif %}
    }
}

{% endif %}
{% if not conversion.is_fallible %}
{# --------------------------------------------------------------------------
   Reverse conversion (if infallible and reversible)
   -------------------------------------------------------------------------- #}
{% if conversion.is_reversible %}
/// Converts {{ conversion.target_type }} back to {{ conversion.source_type }}.
impl From<{{ conversion.target_type }}> for {{ conversion.source_type }} {
    fn from(target: {{ conversion.target_type }}) -> Self {
{% if conversion.field_mappings | length > 0 %}
        Self {
{% for mapping in conversion.field_mappings %}
            {{ mapping.source_field }}: target.{{ mapping.target_field }},
{% endfor %}
        }
{% else %}
        Self::default()
{% endif %}
    }
}

{% endif %}
{% endif %}
{% endfor %}

{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://ggen.io/ontology/a2a/>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

   CONSTRUCT {
       ?conversion a a2a:GeneratedConversion ;
           a2a:sourceType ?sourceName ;
           a2a:targetType ?targetName ;
           a2a:isFallible ?fallible ;
           a2a:isReversible ?reversible ;
           a2a:conversionDoc ?doc ;
           a2a:hasFieldMapping ?mapping .

       ?mapping a a2a:FieldMapping ;
           a2a:sourceField ?sourceFieldName ;
           a2a:targetField ?targetFieldName ;
           a2a:transform ?transformExpr ;
           a2a:required ?required .
   }
   WHERE {
       # Find related types through shared properties or inheritance
       ?sourceType a a2a:Entity ;
           a2a:name ?sourceName ;
           a2a:convertsTo ?targetType .

       ?targetType a a2a:Entity ;
           a2a:name ?targetName .

       BIND(IRI(CONCAT(str(?sourceType), "_to_", str(?targetType))) AS ?conversion)

       OPTIONAL { ?conversion rdfs:comment ?doc }
       OPTIONAL { ?conversion a2a:fallible ?fallible }
       OPTIONAL { ?conversion a2a:reversible ?reversible }

       # Field mappings between source and target
       OPTIONAL {
           ?sourceType a2a:hasProperty ?sourceProp .
           ?targetType a2a:hasProperty ?targetProp .

           # Match by name or explicit mapping
           {
               ?sourceProp a2a:name ?fieldName .
               ?targetProp a2a:name ?fieldName .
               BIND(?fieldName AS ?sourceFieldName)
               BIND(?fieldName AS ?targetFieldName)
           }
           UNION
           {
               ?conversion a2a:mapsField ?mapping .
               ?mapping a2a:source ?sourceProp ;
                   a2a:target ?targetProp .
               ?sourceProp a2a:name ?sourceFieldName .
               ?targetProp a2a:name ?targetFieldName .
           }

           BIND(IRI(CONCAT(str(?conversion), "_map_", ?sourceFieldName)) AS ?mapping)

           OPTIONAL { ?mapping a2a:transform ?transformExpr }
           OPTIONAL { ?targetProp a2a:required ?required }
       }
   }
   ORDER BY ?sourceName ?targetName ?sourceFieldName
   ============================================================================
#}
