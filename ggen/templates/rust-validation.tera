---
# Template: rust-validation.tera
# Description: Generates Rust validation impl blocks for A2A Protocol domain types
#              from SPARQL CONSTRUCT query results against the A2A ontology.
#
# Input context (from SPARQL CONSTRUCT):
#   types: array of objects, each representing a domain type with:
#     - name: string           -- Rust struct name (e.g. "AgentCard")
#     - description: string    -- doc comment for the validate method
#     - properties: array of objects, each with:
#         - name: string              -- field name in Rust (snake_case)
#         - property_type: string     -- "string" | "integer" | "float" | "boolean" | "array" | "object"
#         - required: bool            -- whether the field is required (non-Option)
#         - optional: bool            -- whether the field is Option<T>
#         - min_length: int|null      -- minimum string length constraint
#         - max_length: int|null      -- maximum string length constraint
#         - min_value: number|null    -- minimum numeric value constraint
#         - max_value: number|null    -- maximum numeric value constraint
#         - pattern: string|null      -- regex pattern constraint
#         - format: string|null       -- format type: "email" | "uri" | "datetime" | "uuid" | "base64"
#         - const_value: string|null  -- constant value constraint (discriminator fields)
#         - description: string       -- doc comment for the field validation
#
# SPARQL CONSTRUCT query (reference):
#   PREFIX a2a: <https://ggen.io/ontology/a2a/>
#   PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
#   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
#
#   CONSTRUCT {
#     ?type a a2a:ValidatedType ;
#       a2a:typeName ?typeName ;
#       a2a:typeDescription ?typeDesc ;
#       a2a:hasConstrainedProperty ?prop .
#
#     ?prop a a2a:ConstrainedProperty ;
#       a2a:fieldName ?fieldName ;
#       a2a:fieldType ?fieldType ;
#       a2a:isRequired ?required ;
#       a2a:minLength ?minLen ;
#       a2a:maxLength ?maxLen ;
#       a2a:minValue ?minVal ;
#       a2a:maxValue ?maxVal ;
#       a2a:pattern ?pattern ;
#       a2a:format ?format ;
#       a2a:constValue ?constVal ;
#       a2a:fieldDescription ?fieldDesc .
#   }
#   WHERE {
#     ?type a a2a:Entity ;
#       a2a:entityName ?typeName .
#     OPTIONAL { ?type rdfs:comment ?typeDesc }
#
#     ?type a2a:hasProperty ?prop .
#     ?prop a2a:propertyName ?fieldName ;
#           a2a:propertyType ?fieldType .
#     OPTIONAL { ?prop a2a:isRequired ?required }
#     OPTIONAL { ?prop a2a:minLength ?minLen }
#     OPTIONAL { ?prop a2a:maxLength ?maxLen }
#     OPTIONAL { ?prop a2a:minValue ?minVal }
#     OPTIONAL { ?prop a2a:maxValue ?maxVal }
#     OPTIONAL { ?prop a2a:pattern ?pattern }
#     OPTIONAL { ?prop a2a:format ?format }
#     OPTIONAL { ?prop a2a:constValue ?constVal }
#     OPTIONAL { ?prop a2a:description ?fieldDesc }
#   }
#   ORDER BY ?typeName ?fieldName
#
# Output: Rust source file with validation impl blocks
---
//! Auto-generated validation implementations for A2A Protocol domain types.
//!
//! Generated by `rust-validation.tera` from SPARQL CONSTRUCT query results
//! against the A2A Protocol ontology v0.3.0.
//!
//! DO NOT EDIT THIS FILE MANUALLY. Regenerate with:
//! ```sh
//! ggen generate --template rust-validation.tera --output src/domain/generated_validation.rs
//! ```

use crate::domain::error::A2AError;

/// Validation error kinds produced by ontology-driven constraint checks.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ValidationError {
    /// A required field was missing or empty.
    Required(String),
    /// A string field violated its minimum length constraint.
    MinLength(String, usize),
    /// A string field violated its maximum length constraint.
    MaxLength(String, usize),
    /// A numeric field was below its minimum allowed value.
    MinValue(String, String),
    /// A numeric field exceeded its maximum allowed value.
    MaxValue(String, String),
    /// A field did not match the expected regex pattern.
    Pattern(String, String),
    /// A field did not match the expected format (e.g. email, uri, datetime).
    Format(String, String),
    /// A discriminator field did not match its expected constant value.
    ConstValue(String, String, String),
}

impl std::fmt::Display for ValidationError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            ValidationError::Required(field) => {
                write!(f, "required field '{}' is missing or empty", field)
            }
            ValidationError::MinLength(field, min) => {
                write!(f, "field '{}' must be at least {} characters", field, min)
            }
            ValidationError::MaxLength(field, max) => {
                write!(f, "field '{}' must be at most {} characters", field, max)
            }
            ValidationError::MinValue(field, min) => {
                write!(f, "field '{}' must be >= {}", field, min)
            }
            ValidationError::MaxValue(field, max) => {
                write!(f, "field '{}' must be <= {}", field, max)
            }
            ValidationError::Pattern(field, pattern) => {
                write!(f, "field '{}' must match pattern '{}'", field, pattern)
            }
            ValidationError::Format(field, format) => {
                write!(f, "field '{}' must be a valid {}", field, format)
            }
            ValidationError::ConstValue(field, expected, actual) => {
                write!(
                    f,
                    "field '{}' must be '{}', got '{}'",
                    field, expected, actual
                )
            }
        }
    }
}

impl std::error::Error for ValidationError {}

impl From<ValidationError> for A2AError {
    fn from(err: ValidationError) -> Self {
        A2AError::ValidationError {
            field: match &err {
                ValidationError::Required(f)
                | ValidationError::MinLength(f, _)
                | ValidationError::MaxLength(f, _)
                | ValidationError::MinValue(f, _)
                | ValidationError::MaxValue(f, _)
                | ValidationError::Pattern(f, _)
                | ValidationError::Format(f, _)
                | ValidationError::ConstValue(f, _, _) => f.clone(),
            },
            message: err.to_string(),
        }
    }
}

{% for type in types %}
// ---------------------------------------------------------------------------
// Validation for {{ type.name }}
// ---------------------------------------------------------------------------

impl {{ type.name }} {
    /// Validates this `{{ type.name }}` instance against ontology-derived constraints.
    ///
    {% if type.description %}/// {{ type.description }}
    ///
    {% endif %}/// # Errors
    ///
    /// Returns `Err(ValidationError)` if any constraint is violated:
    {% for prop in type.properties %}{% if prop.required %}///  - `{{ prop.name }}`: required field
    {% endif %}{% if prop.min_length %}///  - `{{ prop.name }}`: minLength={{ prop.min_length }}
    {% endif %}{% if prop.max_length %}///  - `{{ prop.name }}`: maxLength={{ prop.max_length }}
    {% endif %}{% if prop.min_value %}///  - `{{ prop.name }}`: min={{ prop.min_value }}
    {% endif %}{% if prop.max_value %}///  - `{{ prop.name }}`: max={{ prop.max_value }}
    {% endif %}{% if prop.pattern %}///  - `{{ prop.name }}`: pattern={{ prop.pattern }}
    {% endif %}{% if prop.format %}///  - `{{ prop.name }}`: format={{ prop.format }}
    {% endif %}{% if prop.const_value %}///  - `{{ prop.name }}`: const={{ prop.const_value }}
    {% endif %}{% endfor %}pub fn validate(&self) -> Result<(), ValidationError> {
{% for prop in type.properties %}
{% if prop.const_value %}
        // {{ prop.name }}: must equal constant "{{ prop.const_value }}"
        if self.{{ prop.name }} != "{{ prop.const_value }}" {
            return Err(ValidationError::ConstValue(
                "{{ prop.name }}".into(),
                "{{ prop.const_value }}".into(),
                self.{{ prop.name }}.clone(),
            ));
        }
{% elif prop.required and prop.property_type == "string" %}
        // {{ prop.name }}: required string
        if self.{{ prop.name }}.is_empty() {
            return Err(ValidationError::Required("{{ prop.name }}".into()));
        }
{% if prop.min_length %}
        if self.{{ prop.name }}.len() < {{ prop.min_length }} {
            return Err(ValidationError::MinLength(
                "{{ prop.name }}".into(),
                {{ prop.min_length }},
            ));
        }
{% endif %}
{% if prop.max_length %}
        if self.{{ prop.name }}.len() > {{ prop.max_length }} {
            return Err(ValidationError::MaxLength(
                "{{ prop.name }}".into(),
                {{ prop.max_length }},
            ));
        }
{% endif %}
{% if prop.pattern %}
        {
            let re = regex::Regex::new(r"{{ prop.pattern }}")
                .expect("invalid regex in ontology constraint for {{ prop.name }}");
            if !re.is_match(&self.{{ prop.name }}) {
                return Err(ValidationError::Pattern(
                    "{{ prop.name }}".into(),
                    r"{{ prop.pattern }}".into(),
                ));
            }
        }
{% endif %}
{% if prop.format == "email" %}
        // {{ prop.name }}: email format
        if !self.{{ prop.name }}.contains('@') || !self.{{ prop.name }}.contains('.') {
            return Err(ValidationError::Format(
                "{{ prop.name }}".into(),
                "email".into(),
            ));
        }
{% elif prop.format == "uri" %}
        // {{ prop.name }}: URI format
        url::Url::parse(&self.{{ prop.name }})
            .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "uri".into()))?;
{% elif prop.format == "datetime" %}
        // {{ prop.name }}: ISO 8601 datetime format
        chrono::DateTime::parse_from_rfc3339(&self.{{ prop.name }})
            .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "datetime".into()))?;
{% elif prop.format == "uuid" %}
        // {{ prop.name }}: UUID format
        uuid::Uuid::parse_str(&self.{{ prop.name }})
            .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "uuid".into()))?;
{% elif prop.format == "base64" %}
        // {{ prop.name }}: base64 format
        base64::Engine::decode(
            &base64::engine::general_purpose::STANDARD,
            &self.{{ prop.name }},
        )
        .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "base64".into()))?;
{% endif %}
{% elif prop.required and prop.property_type == "array" %}
        // {{ prop.name }}: required array (must not be empty)
        if self.{{ prop.name }}.is_empty() {
            return Err(ValidationError::Required("{{ prop.name }}".into()));
        }
{% elif prop.required and prop.property_type == "integer" %}
        // {{ prop.name }}: required integer
{% if prop.min_value %}
        if self.{{ prop.name }} < {{ prop.min_value }} {
            return Err(ValidationError::MinValue(
                "{{ prop.name }}".into(),
                "{{ prop.min_value }}".into(),
            ));
        }
{% endif %}
{% if prop.max_value %}
        if self.{{ prop.name }} > {{ prop.max_value }} {
            return Err(ValidationError::MaxValue(
                "{{ prop.name }}".into(),
                "{{ prop.max_value }}".into(),
            ));
        }
{% endif %}
{% elif prop.required and prop.property_type == "float" %}
        // {{ prop.name }}: required float
{% if prop.min_value %}
        if self.{{ prop.name }} < {{ prop.min_value }}_f64 {
            return Err(ValidationError::MinValue(
                "{{ prop.name }}".into(),
                "{{ prop.min_value }}".into(),
            ));
        }
{% endif %}
{% if prop.max_value %}
        if self.{{ prop.name }} > {{ prop.max_value }}_f64 {
            return Err(ValidationError::MaxValue(
                "{{ prop.name }}".into(),
                "{{ prop.max_value }}".into(),
            ));
        }
{% endif %}
{% elif prop.optional and prop.property_type == "string" %}
        // {{ prop.name }}: optional string
        if let Some(ref val) = self.{{ prop.name }} {
{% if prop.min_length %}
            if val.len() < {{ prop.min_length }} {
                return Err(ValidationError::MinLength(
                    "{{ prop.name }}".into(),
                    {{ prop.min_length }},
                ));
            }
{% endif %}
{% if prop.max_length %}
            if val.len() > {{ prop.max_length }} {
                return Err(ValidationError::MaxLength(
                    "{{ prop.name }}".into(),
                    {{ prop.max_length }},
                ));
            }
{% endif %}
{% if prop.pattern %}
            {
                let re = regex::Regex::new(r"{{ prop.pattern }}")
                    .expect("invalid regex in ontology constraint for {{ prop.name }}");
                if !re.is_match(val) {
                    return Err(ValidationError::Pattern(
                        "{{ prop.name }}".into(),
                        r"{{ prop.pattern }}".into(),
                    ));
                }
            }
{% endif %}
{% if prop.format == "email" %}
            // email format
            if !val.contains('@') || !val.contains('.') {
                return Err(ValidationError::Format(
                    "{{ prop.name }}".into(),
                    "email".into(),
                ));
            }
{% elif prop.format == "uri" %}
            // URI format
            url::Url::parse(val)
                .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "uri".into()))?;
{% elif prop.format == "datetime" %}
            // ISO 8601 datetime format
            chrono::DateTime::parse_from_rfc3339(val)
                .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "datetime".into()))?;
{% elif prop.format == "uuid" %}
            // UUID format
            uuid::Uuid::parse_str(val)
                .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "uuid".into()))?;
{% elif prop.format == "base64" %}
            // base64 format
            base64::Engine::decode(
                &base64::engine::general_purpose::STANDARD,
                val,
            )
            .map_err(|_| ValidationError::Format("{{ prop.name }}".into(), "base64".into()))?;
{% endif %}
        }
{% elif prop.optional and prop.property_type == "integer" %}
        // {{ prop.name }}: optional integer
        if let Some(val) = self.{{ prop.name }} {
{% if prop.min_value %}
            if val < {{ prop.min_value }} {
                return Err(ValidationError::MinValue(
                    "{{ prop.name }}".into(),
                    "{{ prop.min_value }}".into(),
                ));
            }
{% endif %}
{% if prop.max_value %}
            if val > {{ prop.max_value }} {
                return Err(ValidationError::MaxValue(
                    "{{ prop.name }}".into(),
                    "{{ prop.max_value }}".into(),
                ));
            }
{% endif %}
        }
{% elif prop.optional and prop.property_type == "float" %}
        // {{ prop.name }}: optional float
        if let Some(val) = self.{{ prop.name }} {
{% if prop.min_value %}
            if val < {{ prop.min_value }}_f64 {
                return Err(ValidationError::MinValue(
                    "{{ prop.name }}".into(),
                    "{{ prop.min_value }}".into(),
                ));
            }
{% endif %}
{% if prop.max_value %}
            if val > {{ prop.max_value }}_f64 {
                return Err(ValidationError::MaxValue(
                    "{{ prop.name }}".into(),
                    "{{ prop.max_value }}".into(),
                ));
            }
{% endif %}
        }
{% endif %}
{% endfor %}
        Ok(())
    }
}
{% endfor %}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_validation_error_display() {
        let err = ValidationError::Required("name".into());
        assert_eq!(err.to_string(), "required field 'name' is missing or empty");

        let err = ValidationError::MinLength("name".into(), 3);
        assert_eq!(
            err.to_string(),
            "field 'name' must be at least 3 characters"
        );

        let err = ValidationError::MaxLength("name".into(), 100);
        assert_eq!(
            err.to_string(),
            "field 'name' must be at most 100 characters"
        );

        let err = ValidationError::MinValue("page_size".into(), "1".into());
        assert_eq!(err.to_string(), "field 'page_size' must be >= 1");

        let err = ValidationError::MaxValue("page_size".into(), "100".into());
        assert_eq!(err.to_string(), "field 'page_size' must be <= 100");

        let err = ValidationError::Pattern("id".into(), "^[a-z]+$".into());
        assert_eq!(
            err.to_string(),
            "field 'id' must match pattern '^[a-z]+$'"
        );

        let err = ValidationError::Format("url".into(), "uri".into());
        assert_eq!(err.to_string(), "field 'url' must be a valid uri");

        let err = ValidationError::ConstValue(
            "kind".into(),
            "message".into(),
            "task".into(),
        );
        assert_eq!(
            err.to_string(),
            "field 'kind' must be 'message', got 'task'"
        );
    }

    #[test]
    fn test_validation_error_into_a2a_error() {
        let err = ValidationError::Required("name".into());
        let a2a_err: A2AError = err.into();
        match a2a_err {
            A2AError::ValidationError { field, message } => {
                assert_eq!(field, "name");
                assert!(message.contains("required"));
            }
            _ => panic!("expected ValidationError variant"),
        }
    }
}
