---
# rust-mod.tera - Generates Rust mod.rs barrel export files
#
# Expected SPARQL CONSTRUCT result variables:
#   modules: list of objects, each with:
#     - name: module name (e.g., "agent", "message", "task")
#     - exports: list of public type/trait names to re-export
#
# Template variables:
#   module_path: the dotted module path (e.g., "domain::core", "domain::protocols", "port")
#   doc_comment: top-level module documentation string
#   protocol_version: A2A protocol version (e.g., "0.3.0")
#   modules: list of submodule descriptors from SPARQL results
#   conditional_modules: optional list of feature-gated modules
---
//! {{ doc_comment }}
//! Generated by ggen from RDF ontology - DO NOT EDIT
//!
//! Module path: {{ module_path }}
//! A2A Protocol v{{ protocol_version }}
{% for module in modules %}

{% if module.doc_comment is defined %}
/// {{ module.doc_comment }}
{% endif %}
{% if module.feature_gate is defined %}
#[cfg(feature = "{{ module.feature_gate }}")]
{% endif %}
{% if module.test_only is defined and module.test_only %}
#[cfg(test)]
{% endif %}
pub mod {{ module.name }};
{%- endfor %}
{% if modules | length > 0 %}

// Re-export public types for convenience
{% for module in modules %}
{% if module.exports is defined and module.exports | length > 0 %}
{% if module.feature_gate is defined %}
#[cfg(feature = "{{ module.feature_gate }}")]
{% endif %}
{% if module.test_only is defined and module.test_only %}
#[cfg(test)]
{% endif %}
{% if module.reexport_style is defined and module.reexport_style == "glob" %}
pub use {{ module.name }}::*;
{% else %}
pub use {{ module.name }}::{
{% for export in module.exports %}
    {{ export }},
{% endfor %}
};
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
