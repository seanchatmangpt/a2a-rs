---
output_file: mock_implementations.rs
description: >
  Generates mock trait implementations for testing. Creates simple,
  in-memory mock implementations of port traits with configurable
  responses and behavior tracking.
variables:
  traits: >
    Array of trait descriptors with methods and parameters extracted
    from SPARQL CONSTRUCT results on Port definitions.
---
{# ============================================================================
   mock_implementations.rs.tera
   ============================================================================
   Tera template for generating mock trait implementations for testing.

   This template generates mock implementations of port traits for use in
   tests. Each mock provides:
   - In-memory storage for state
   - Configurable responses
   - Call tracking for verification
   - Simple default behavior

   Expected context variables:
   - traits: array of trait descriptors, each containing:
       - name:           String  -- Trait name (e.g. "MessageHandler")
       - description:    String? -- Documentation
       - is_async:       bool    -- Whether trait methods are async
       - methods: array of method descriptors, each containing:
           - name:          String  -- Method name
           - is_async:      bool    -- Whether async
           - return_type:   String  -- Return type signature
           - params: array of parameter descriptors, each with:
               - name:      String  -- Parameter name
               - type:      String  -- Parameter type
               - is_ref:    bool    -- Whether &T
               - is_mut:    bool    -- Whether &mut T
   ============================================================================
#}
//! Auto-generated mock implementations for A2A Protocol port traits.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.
//!
//! These mocks provide simple, in-memory implementations for testing
//! without requiring actual network connections or external services.

#![cfg(test)]

use async_trait::async_trait;
use std::sync::{Arc, Mutex};
use std::collections::HashMap;

{% for trait in traits %}
{# --------------------------------------------------------------------------
   Mock struct definition
   -------------------------------------------------------------------------- #}
{% if trait.description %}
/// Mock implementation of {{ trait.name }}.
/// {{ trait.description | split(pat="\n") | first }}
{% else %}
/// Mock implementation of {{ trait.name }} for testing.
{% endif %}
///
/// # Features
///
/// - In-memory storage
/// - Configurable responses
/// - Call tracking for verification
///
/// # Example
///
/// ```
/// use a2a_rs::port::{{ trait.name }};
/// use a2a_rs::generated::Mock{{ trait.name }};
///
/// let mock = Mock{{ trait.name }}::new();
{% for method in trait.methods %}
/// // Configure response for {{ method.name }}
/// mock.configure_{{ method.name }}_response(expected_result);
{% endfor %}
/// ```
#[derive(Clone)]
pub struct Mock{{ trait.name }} {
    /// Shared state for tracking calls and responses
    state: Arc<Mutex<Mock{{ trait.name }}State>>,
}

#[derive(Default)]
struct Mock{{ trait.name }}State {
{% for method in trait.methods %}
    /// Configured response for {{ method.name }}
    {{ method.name }}_response: Option<{{ method.return_type | replace(from="Result<", to="") | replace(from=", crate::domain::error::A2AError>", to="") }}>,
    /// Number of times {{ method.name }} was called
    {{ method.name }}_call_count: usize,
{% endfor %}
{% if trait.needs_storage %}
    /// In-memory storage
    storage: HashMap<String, Vec<u8>>,
{% endif %}
}

impl Mock{{ trait.name }} {
    /// Create a new mock {{ trait.name }} instance.
    pub fn new() -> Self {
        Self {
            state: Arc::new(Mutex::new(Mock{{ trait.name }}State::default())),
        }
    }

{% for method in trait.methods %}
    /// Configure the response for `{{ method.name }}`.
    pub fn configure_{{ method.name }}_response(&self, response: {{ method.return_type | replace(from="Result<", to="") | replace(from=", crate::domain::error::A2AError>", to="") }}) {
        let mut state = self.state.lock().unwrap();
        state.{{ method.name }}_response = Some(response);
    }

    /// Get the number of times `{{ method.name }}` was called.
    pub fn {{ method.name }}_call_count(&self) -> usize {
        let state = self.state.lock().unwrap();
        state.{{ method.name }}_call_count
    }

{% endfor %}
    /// Reset all call counts and responses.
    pub fn reset(&self) {
        let mut state = self.state.lock().unwrap();
        *state = Mock{{ trait.name }}State::default();
    }
}

impl Default for Mock{{ trait.name }} {
    fn default() -> Self {
        Self::new()
    }
}

{# --------------------------------------------------------------------------
   Trait implementation
   -------------------------------------------------------------------------- #}
{% if trait.is_async %}
#[async_trait]
{% endif %}
impl crate::port::{{ trait.name }} for Mock{{ trait.name }} {
{% for method in trait.methods %}
{# --------------------------------------------------------------------------
   Method implementation
   -------------------------------------------------------------------------- #}
{% if method.is_async %}
    async fn {{ method.name }}(
{% else %}
    fn {{ method.name }}(
{% endif %}
        &self,
{% for param in method.params %}
        {{ param.name }}: {% if param.is_mut %}&mut {% elif param.is_ref %}&{% endif %}{{ param.type }},
{% endfor %}
    ) -> {{ method.return_type }} {
        // Track call
        {
            let mut state = self.state.lock().unwrap();
            state.{{ method.name }}_call_count += 1;
        }

        // Return configured response or default
        let state = self.state.lock().unwrap();
        if let Some(response) = &state.{{ method.name }}_response {
            Ok(response.clone())
        } else {
{% if method.return_type contains "Result<()" %}
            Ok(())
{% elif method.return_type contains "Result<Vec<" %}
            Ok(vec![])
{% elif method.return_type contains "Result<Option<" %}
            Ok(None)
{% elif method.return_type contains "Result<String" %}
            Ok("mock-id".to_string())
{% elif method.return_type contains "Result<bool" %}
            Ok(true)
{% else %}
            // Default value for {{ method.return_type }}
            Ok(Default::default())
{% endif %}
        }
    }

{% endfor %}
}

{% endfor %}

{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://ggen.io/ontology/a2a/>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

   CONSTRUCT {
       ?port a a2a:GeneratedMock ;
           a2a:traitName ?name ;
           a2a:traitDoc ?doc ;
           a2a:isAsync ?isAsync ;
           a2a:needsStorage ?needsStorage ;
           a2a:hasMethod ?method .

       ?method a a2a:MockMethod ;
           a2a:methodName ?methodName ;
           a2a:methodDoc ?methodDoc ;
           a2a:isAsync ?methodAsync ;
           a2a:returnType ?returnType ;
           a2a:hasParam ?param .

       ?param a a2a:MockParam ;
           a2a:paramName ?paramName ;
           a2a:paramType ?paramType ;
           a2a:isRef ?isRef ;
           a2a:isMut ?isMut .
   }
   WHERE {
       ?port a a2a:Port ;
           a2a:name ?name .

       OPTIONAL { ?port rdfs:comment ?doc }
       OPTIONAL { ?port a2a:async ?isAsync }
       OPTIONAL { ?port a2a:needsStorage ?needsStorage }

       ?port a2a:hasMethod ?method .
       ?method a2a:name ?methodName .

       OPTIONAL { ?method rdfs:comment ?methodDoc }
       OPTIONAL { ?method a2a:async ?methodAsync }
       OPTIONAL { ?method a2a:returnType ?returnType }

       # Parameters (excluding &self)
       OPTIONAL {
           ?method a2a:hasParam ?param .
           ?param a2a:name ?paramName ;
               a2a:type ?paramType .

           FILTER(?paramName != "self")

           OPTIONAL { ?param a2a:borrowed ?isRef }
           OPTIONAL { ?param a2a:mutable ?isMut }
       }
   }
   ORDER BY ?name ?methodName ?paramName
   ============================================================================
#}
