---
output_file: test_fixtures.rs
description: >
  Generates proptest Arbitrary implementations for A2A Protocol domain types.
  Provides property-based testing fixtures with valid value generation strategies
  derived from ontology constraints.
variables:
  types: >
    Array of type descriptors with fields, constraints, and generation strategies
    extracted from SPARQL CONSTRUCT results.
---
{# ============================================================================
   test_fixtures.rs.tera
   ============================================================================
   Tera template for generating proptest Arbitrary implementations from
   SPARQL CONSTRUCT results against the A2A ontology.

   This template generates test fixtures for property-based testing using
   proptest. Each domain type gets strategies that respect ontology constraints
   like min/max length, patterns, required fields, and type relationships.

   Expected context variables:
   - types: array of type descriptors, each containing:
       - name:           String  -- Rust type name (e.g. "AgentCard")
       - description:    String? -- Documentation for the fixture
       - fields: array of field descriptors, each containing:
           - name:          String  -- Rust field name
           - rust_type:     String  -- Rust type (String, i64, bool, etc.)
           - is_optional:   bool    -- Whether wrapped in Option<T>
           - is_vec:        bool    -- Whether wrapped in Vec<T>
           - min_length:    int?    -- Minimum string/array length
           - max_length:    int?    -- Maximum string/array length
           - pattern:       String? -- Regex pattern for string generation
           - min_value:     number? -- Minimum numeric value
           - max_value:     number? -- Maximum numeric value
           - enum_values:   array?  -- Allowed enum variant strings
   ============================================================================
#}
//! Auto-generated proptest fixtures for A2A Protocol domain types.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.
//!
//! These fixtures provide `proptest` strategies for generating valid test
//! data that respects ontology-defined constraints.

#![cfg(test)]

use proptest::prelude::*;
use base64::Engine;

{% for type in types %}
{# --------------------------------------------------------------------------
   Doc comment for the strategy function
   -------------------------------------------------------------------------- #}
{% if type.description %}
/// Proptest strategy for generating valid {{ type.name }} instances.
/// {{ type.description | split(pat="\n") | first }}
{% else %}
/// Proptest strategy for generating valid {{ type.name }} instances.
{% endif %}
pub fn {{ type.name | snake_case }}_strategy() -> impl Strategy<Value = crate::domain::{{ type.name }}> {
    (
{% for field in type.fields %}
{# --------------------------------------------------------------------------
   Generate appropriate strategy for each field type
   -------------------------------------------------------------------------- #}
{% if field.rust_type == "String" %}
{% if field.pattern %}
        "{{ field.pattern }}", // {{ field.name }}: pattern-based
{% elif field.min_length and field.max_length %}
        "[a-zA-Z0-9 ]{{"{{ field.min_length }}"},{{"{{ field.max_length }}"}}", // {{ field.name }}
{% elif field.max_length %}
        "[a-zA-Z0-9 ]{0,{{"{{ field.max_length }}"}}", // {{ field.name }}
{% else %}
        ".*", // {{ field.name }}: any string
{% endif %}
{% elif field.rust_type == "bool" %}
        any::<bool>(), // {{ field.name }}
{% elif field.rust_type == "i64" or field.rust_type == "i32" %}
{% if field.min_value and field.max_value %}
        {{ field.min_value }}i64..={{ field.max_value }}i64, // {{ field.name }}
{% elif field.min_value %}
        {{ field.min_value }}i64..i64::MAX, // {{ field.name }}
{% elif field.max_value %}
        i64::MIN..={{ field.max_value }}i64, // {{ field.name }}
{% else %}
        any::<i64>(), // {{ field.name }}
{% endif %}
{% elif field.rust_type == "f64" or field.rust_type == "f32" %}
{% if field.min_value and field.max_value %}
        {{ field.min_value }}f64..={{ field.max_value }}f64, // {{ field.name }}
{% else %}
        any::<f64>(), // {{ field.name }}
{% endif %}
{% elif field.rust_type == "url::Url" %}
        "(https?://[a-z0-9.-]+\\.[a-z]{2,})", // {{ field.name }}: URL
{% elif field.rust_type == "chrono::DateTime<chrono::Utc>" %}
        any::<i64>().prop_map(|ts| chrono::DateTime::from_timestamp(ts % 2_000_000_000, 0).unwrap()), // {{ field.name }}
{% elif field.rust_type == "serde_json::Value" %}
        any::<String>().prop_map(|s| serde_json::Value::String(s)), // {{ field.name }}
{% elif field.enum_values %}
        prop::sample::select(vec![
{% for variant in field.enum_values %}
            {{ field.rust_type }}::{{ variant }},
{% endfor %}
        ]), // {{ field.name }}: enum
{% else %}
        {{ field.rust_type | snake_case }}_strategy(), // {{ field.name }}: nested type
{% endif %}
{% endfor %}
    )
        .prop_map(|(
{% for field in type.fields %}
            {{ field.name }},
{% endfor %}
        )| {
{# --------------------------------------------------------------------------
   Build the type instance, handling Option<T> and Vec<T> wrapping
   -------------------------------------------------------------------------- #}
{% if type.use_builder %}
            crate::domain::{{ type.name }}::builder()
{% for field in type.fields %}
{% if field.is_optional %}
                .{{ field.name }}(Some({{ field.name }}))
{% elif field.is_vec %}
                .{{ field.name }}(vec![{{ field.name }}])
{% else %}
                .{{ field.name }}({{ field.name }})
{% endif %}
{% endfor %}
                .build()
{% else %}
            crate::domain::{{ type.name }} {
{% for field in type.fields %}
{% if field.is_optional %}
                {{ field.name }}: Some({{ field.name }}),
{% elif field.is_vec %}
                {{ field.name }}: vec![{{ field.name }}],
{% else %}
                {{ field.name }},
{% endif %}
{% endfor %}
            }
{% endif %}
        })
}

{% if type.fields | length > 0 %}
/// Proptest strategy for generating optional {{ type.name }} instances.
pub fn optional_{{ type.name | snake_case }}_strategy() -> impl Strategy<Value = Option<crate::domain::{{ type.name }}>> {
    prop::option::of({{ type.name | snake_case }}_strategy())
}

/// Proptest strategy for generating vectors of {{ type.name }} instances.
pub fn vec_{{ type.name | snake_case }}_strategy() -> impl Strategy<Value = Vec<crate::domain::{{ type.name }}>> {
    prop::collection::vec({{ type.name | snake_case }}_strategy(), 0..5)
}
{% endif %}

{% endfor %}

{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://ggen.io/ontology/a2a/>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

   CONSTRUCT {
       ?type a a2a:GeneratedTestFixture ;
           a2a:typeName ?name ;
           a2a:typeDoc ?doc ;
           a2a:hasField ?field .

       ?field a a2a:TestField ;
           a2a:fieldName ?fieldName ;
           a2a:rustType ?rustType ;
           a2a:isOptional ?optional ;
           a2a:isVec ?isVec ;
           a2a:minLength ?minLen ;
           a2a:maxLength ?maxLen ;
           a2a:pattern ?pattern ;
           a2a:minValue ?minVal ;
           a2a:maxValue ?maxVal ;
           a2a:enumValues ?enumVals .
   }
   WHERE {
       ?type a a2a:Entity ;
           a2a:name ?name .
       OPTIONAL { ?type rdfs:comment ?doc }

       ?type a2a:hasProperty ?prop .
       ?prop a2a:name ?fieldName ;
           a2a:type ?xsdType .

       # Map to Rust types (same as domain-structs)
       BIND(
           IF(?xsdType = xsd:string, "String",
           IF(?xsdType = xsd:boolean, "bool",
           IF(?xsdType = xsd:integer, "i64",
           IF(?xsdType = xsd:float, "f64",
           str(?xsdType)))))
           AS ?rustType
       )

       OPTIONAL { ?prop a2a:optional ?optional }
       OPTIONAL { ?prop a2a:isArray ?isVec }
       OPTIONAL { ?prop a2a:minLength ?minLen }
       OPTIONAL { ?prop a2a:maxLength ?maxLen }
       OPTIONAL { ?prop a2a:pattern ?pattern }
       OPTIONAL { ?prop a2a:minValue ?minVal }
       OPTIONAL { ?prop a2a:maxValue ?maxVal }
       OPTIONAL {
           ?prop a2a:refEntity ?enumType .
           ?enumType a a2a:EnumType ;
               a2a:hasVariant ?variant .
           ?variant a2a:name ?variantName .
           # Aggregate variant names
       }
   }
   ============================================================================
#}
