---
output_file: serde_tests.rs
description: >
  Generates roundtrip serialization/deserialization tests for all A2A
  Protocol domain types. Ensures JSON serialization is lossless and
  follows the camelCase naming convention from the spec.
variables:
  types: >
    Array of type descriptors with expected JSON field names and example
    values extracted from SPARQL CONSTRUCT results.
---
{# ============================================================================
   serde_tests.rs.tera
   ============================================================================
   Tera template for generating serde roundtrip tests.

   This template generates comprehensive serialization/deserialization tests
   to ensure:
   1. Roundtrip identity (serialize -> deserialize -> serialize is stable)
   2. JSON field naming matches spec (camelCase)
   3. Optional fields are handled correctly
   4. Default values work as expected

   Expected context variables:
   - types: array of type descriptors, each containing:
       - name:           String  -- Rust type name
       - description:    String? -- Documentation
       - example_json:   String? -- Example JSON from ontology
       - fields: array of field descriptors, each containing:
           - name:          String  -- Rust field name (snake_case)
           - json_name:     String  -- JSON field name (camelCase)
           - rust_type:     String  -- Rust type
           - is_optional:   bool    -- Whether Option<T>
           - is_vec:        bool    -- Whether Vec<T>
           - example_value: String? -- Example value for testing
   ============================================================================
#}
//! Auto-generated serde roundtrip tests for A2A Protocol domain types.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.
//!
//! These tests verify that all domain types correctly serialize to/from
//! JSON according to the A2A Protocol v0.3.0 specification.

#![cfg(test)]

use serde_json;

{% for type in types %}
{# --------------------------------------------------------------------------
   Roundtrip test: Rust -> JSON -> Rust
   -------------------------------------------------------------------------- #}
#[test]
fn test_{{ type.name | snake_case }}_roundtrip() {
    // Arrange: Create a {{ type.name }} instance
{% if type.use_builder %}
    let original = crate::domain::{{ type.name }}::builder()
{% for field in type.fields %}
{% if not field.is_optional and field.example_value %}
        .{{ field.name }}({{ field.example_value }})
{% endif %}
{% endfor %}
        .build();
{% else %}
    let original = crate::domain::{{ type.name }} {
{% for field in type.fields %}
{% if field.example_value %}
        {{ field.name }}: {{ field.example_value }},
{% elif field.is_optional %}
        {{ field.name }}: None,
{% elif field.is_vec %}
        {{ field.name }}: vec![],
{% else %}
        {{ field.name }}: Default::default(),
{% endif %}
{% endfor %}
    };
{% endif %}

    // Act: Serialize to JSON
    let json = serde_json::to_string(&original)
        .expect("Failed to serialize {{ type.name }}");

    // Assert: Deserialize back and compare
    let deserialized: crate::domain::{{ type.name }} = serde_json::from_str(&json)
        .expect("Failed to deserialize {{ type.name }}");

    // Verify roundtrip by re-serializing
    let json2 = serde_json::to_string(&deserialized)
        .expect("Failed to re-serialize {{ type.name }}");

    assert_eq!(
        json, json2,
        "{{ type.name }} roundtrip serialization should be stable"
    );
}

{# --------------------------------------------------------------------------
   JSON field naming test: Verify camelCase
   -------------------------------------------------------------------------- #}
#[test]
fn test_{{ type.name | snake_case }}_json_field_names() {
{% if type.use_builder %}
    let instance = crate::domain::{{ type.name }}::builder()
{% for field in type.fields %}
{% if not field.is_optional and field.example_value %}
        .{{ field.name }}({{ field.example_value }})
{% endif %}
{% endfor %}
        .build();
{% else %}
    let instance = crate::domain::{{ type.name }} {
{% for field in type.fields %}
{% if field.example_value %}
        {{ field.name }}: {{ field.example_value }},
{% elif field.is_optional %}
        {{ field.name }}: None,
{% elif field.is_vec %}
        {{ field.name }}: vec![],
{% else %}
        {{ field.name }}: Default::default(),
{% endif %}
{% endfor %}
    };
{% endif %}

    let json = serde_json::to_value(&instance)
        .expect("Failed to serialize {{ type.name }} to JSON Value");

    let obj = json.as_object()
        .expect("{{ type.name }} should serialize to JSON object");

    // Verify expected field names (camelCase)
{% for field in type.fields %}
{% if not field.is_optional or field.example_value %}
    assert!(
        obj.contains_key("{{ field.json_name }}"),
        "{{ type.name }} JSON should contain field '{{ field.json_name }}'"
    );
{% endif %}
{% endfor %}

    // Verify no unexpected fields (snake_case leakage)
{% for field in type.fields %}
{% if field.name != field.json_name %}
    assert!(
        !obj.contains_key("{{ field.name }}"),
        "{{ type.name }} JSON should NOT contain snake_case field '{{ field.name }}'"
    );
{% endif %}
{% endfor %}
}

{# --------------------------------------------------------------------------
   Optional fields test: Verify skip_serializing_if works
   -------------------------------------------------------------------------- #}
{% if type.fields | filter(attribute="is_optional") | length > 0 %}
#[test]
fn test_{{ type.name | snake_case }}_optional_fields() {
    // Create instance with all optional fields as None
{% if type.use_builder %}
    let instance = crate::domain::{{ type.name }}::builder()
{% for field in type.fields %}
{% if not field.is_optional and field.example_value %}
        .{{ field.name }}({{ field.example_value }})
{% elif not field.is_optional %}
        .{{ field.name }}(Default::default())
{% endif %}
{% endfor %}
        .build();
{% else %}
    let instance = crate::domain::{{ type.name }} {
{% for field in type.fields %}
{% if field.is_optional %}
        {{ field.name }}: None,
{% elif field.example_value %}
        {{ field.name }}: {{ field.example_value }},
{% elif field.is_vec %}
        {{ field.name }}: vec![],
{% else %}
        {{ field.name }}: Default::default(),
{% endif %}
{% endfor %}
    };
{% endif %}

    let json = serde_json::to_value(&instance)
        .expect("Failed to serialize {{ type.name }}");

    let obj = json.as_object()
        .expect("{{ type.name }} should serialize to JSON object");

    // Verify optional fields are omitted when None
{% for field in type.fields %}
{% if field.is_optional %}
    assert!(
        !obj.contains_key("{{ field.json_name }}"),
        "Optional field '{{ field.json_name }}' should be omitted when None"
    );
{% endif %}
{% endfor %}
}
{% endif %}

{% if type.example_json %}
{# --------------------------------------------------------------------------
   Spec example test: Deserialize from ontology example JSON
   -------------------------------------------------------------------------- #}
#[test]
fn test_{{ type.name | snake_case }}_from_spec_example() {
    let json = r#"{{ type.example_json }}"#;

    let result: Result<crate::domain::{{ type.name }}, _> = serde_json::from_str(json);

    assert!(
        result.is_ok(),
        "{{ type.name }} should deserialize from spec example JSON: {:?}",
        result.err()
    );
}
{% endif %}

{% endfor %}

{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://ggen.io/ontology/a2a/>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

   CONSTRUCT {
       ?entity a a2a:GeneratedSerdeTest ;
           a2a:typeName ?name ;
           a2a:typeDoc ?doc ;
           a2a:exampleJson ?exampleJson ;
           a2a:useBuilder ?useBuilder ;
           a2a:hasField ?field .

       ?field a a2a:SerdeTestField ;
           a2a:fieldName ?fieldName ;
           a2a:jsonName ?jsonName ;
           a2a:rustType ?rustType ;
           a2a:isOptional ?optional ;
           a2a:isVec ?isVec ;
           a2a:exampleValue ?exampleVal .
   }
   WHERE {
       ?entity a a2a:Entity ;
           a2a:name ?name .

       OPTIONAL { ?entity rdfs:comment ?doc }
       OPTIONAL { ?entity a2a:example ?exampleJson }

       # Determine if type should use builder (3+ fields)
       {
           SELECT ?entity (COUNT(?p) AS ?fieldCount)
           WHERE {
               ?entity a2a:hasProperty ?p .
           }
           GROUP BY ?entity
       }
       BIND(IF(?fieldCount >= 3, true, false) AS ?useBuilder)

       ?entity a2a:hasProperty ?field .
       ?field a2a:name ?fieldName ;
           a2a:type ?xsdType .

       # JSON name (camelCase)
       OPTIONAL { ?field a2a:jsonName ?jsonName }
       BIND(IF(BOUND(?jsonName), ?jsonName, ?fieldName) AS ?jsonName)

       # Map to Rust types
       BIND(
           IF(?xsdType = xsd:string, "String",
           IF(?xsdType = xsd:boolean, "bool",
           IF(?xsdType = xsd:integer, "i64",
           IF(?xsdType = xsd:float, "f64",
           str(?xsdType)))))
           AS ?rustType
       )

       OPTIONAL { ?field a2a:optional ?optional }
       OPTIONAL { ?field a2a:isArray ?isVec }
       OPTIONAL { ?field a2a:example ?exampleVal }
   }
   ORDER BY ?name ?fieldName
   ============================================================================
#}
