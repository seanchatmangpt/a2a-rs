---
# rust-port-traits.tera
#
# Tera template for generating Rust async trait definitions (ports) from
# SPARQL CONSTRUCT query results describing an Agent-to-Agent protocol.
#
# Expected RDF vocabulary / context variables
# --------------------------------------------
# The SPARQL CONSTRUCT query should produce triples that are grouped into
# a context object with the following structure:
#
#   module_doc   : str   -- top-level module doc comment
#   imports      : [str] -- additional `use` paths beyond the defaults
#   traits       : list of trait objects, each containing:
#       name          : str            -- trait name, e.g. "MessageHandler"
#       async_name    : str            -- async variant name, e.g. "AsyncMessageHandler"
#       description   : str            -- rdfs:comment / schema:description
#       async_description : str        -- doc comment for the async variant
#       feature_gate  : str | None     -- optional feature flag, e.g. "server"
#       supertraits   : [str]          -- additional supertraits beyond Send + Sync
#       methods       : list of method objects:
#           name        : str          -- method name, e.g. "process_message"
#           description : str          -- rdfs:comment for the method
#           is_async    : bool         -- true for async-only methods (no sync variant)
#           has_default : bool         -- true if a default implementation exists
#           default_body: str | None   -- default implementation body (Rust code)
#           params      : list of parameter objects:
#               name      : str        -- parameter name
#               type      : str        -- Rust type expression
#               is_ref    : bool       -- true if passed by reference
#               has_lifetime : bool    -- true if the async variant needs 'a lifetime
#           return_type : str          -- Rust type for the return, e.g. "Task"
#           return_wrap : str          -- wrapping, e.g. "Result" | "Option" | "Vec"
#           error_type  : str          -- error type, default "A2AError"
#       supporting_types : list of supporting type objects (enums/structs):
#           name        : str
#           description : str
#           kind        : str          -- "enum" or "struct"
#           derives     : [str]        -- derive macros
#           variants    : list (for enums):
#               name    : str
#               inner   : str | None   -- inner type for tuple variants
#           fields      : list (for structs):
#               name    : str
#               type    : str
#               description : str
#
# SPARQL CONSTRUCT query example
# --------------------------------
# PREFIX a2a:  <https://a2aprotocol.ai/ontology#>
# PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# PREFIX port: <https://a2aprotocol.ai/ontology/port#>
#
# CONSTRUCT {
#   ?trait a a2a:PortTrait ;
#          rdfs:label       ?traitName ;
#          rdfs:comment     ?traitDesc ;
#          port:featureGate ?featureGate ;
#          port:hasMethod   ?method .
#
#   ?method a a2a:TraitMethod ;
#           rdfs:label       ?methodName ;
#           rdfs:comment     ?methodDesc ;
#           port:hasParam    ?param ;
#           port:returnType  ?returnType ;
#           port:returnWrap  ?returnWrap ;
#           port:errorType   ?errorType .
#
#   ?param  a a2a:MethodParam ;
#           rdfs:label   ?paramName ;
#           port:paramType ?paramType ;
#           port:isRef     ?isRef ;
#           port:hasLifetime ?hasLifetime .
# }
# WHERE {
#   ?trait a a2a:PortTrait ;
#          rdfs:label   ?traitName ;
#          rdfs:comment ?traitDesc .
#   OPTIONAL { ?trait port:featureGate ?featureGate }
#   ?trait port:hasMethod ?method .
#   ?method rdfs:label   ?methodName ;
#           rdfs:comment ?methodDesc .
#   OPTIONAL { ?method port:hasParam ?param .
#              ?param rdfs:label     ?paramName ;
#                     port:paramType ?paramType .
#              OPTIONAL { ?param port:isRef ?isRef }
#              OPTIONAL { ?param port:hasLifetime ?hasLifetime }
#   }
#   OPTIONAL { ?method port:returnType ?returnType }
#   OPTIONAL { ?method port:returnWrap ?returnWrap }
#   OPTIONAL { ?method port:errorType  ?errorType }
# }
---
{# ────────────────────────────────────────────────────────────────────────────
   rust-port-traits.tera
   Generates Rust port trait files following hexagonal architecture patterns
   used by the a2a-rs codebase.
   ──────────────────────────────────────────────────────────────────────────── #}
//! {{ module_doc | default(value="Port trait definitions generated from RDF ontology") }}
//!
//! Ports define the interfaces that the application needs, independent of
//! implementation details. They represent the "what" -- what operations the
//! application needs to perform.
//!
//! Auto-generated by `rust-port-traits.tera` from SPARQL CONSTRUCT results.

{% for trait in traits %}
{% if trait.feature_gate %}
#[cfg(feature = "{{ trait.feature_gate }}")]
{% endif %}
use async_trait::async_trait;
{% endfor %}

use crate::domain::A2AError;
{% for import in imports | default(value=[]) %}
use {{ import }};
{% endfor %}

{% for trait in traits %}
{# ──────────────────────────── Sync trait ──────────────────────────── #}
/// {{ trait.description }}
pub trait {{ trait.name }}{% if trait.supertraits | default(value=[]) | length > 0 %}: {{ trait.supertraits | join(sep=" + ") }}{% endif %} {
{% for method in trait.methods %}
{% if not method.is_async | default(value=false) %}
    /// {{ method.description }}
{% if method.has_default | default(value=false) %}
    fn {{ method.name }}(
        &self,
{% for param in method.params | default(value=[]) %}
{% if param.is_ref | default(value=false) %}
        {{ param.name }}: &{{ param.type }},
{% else %}
        {{ param.name }}: {{ param.type }},
{% endif %}
{% endfor %}
{% if method.return_wrap | default(value="Result") == "Result" %}
    ) -> Result<{{ method.return_type | default(value="()") }}, {{ method.error_type | default(value="A2AError") }}> {
{% elif method.return_wrap == "Option" %}
    ) -> Option<{{ method.return_type | default(value="()") }}> {
{% elif method.return_wrap == "Vec" %}
    ) -> Vec<{{ method.return_type | default(value="()") }}> {
{% else %}
    ) -> {{ method.return_type | default(value="()") }} {
{% endif %}
        {{ method.default_body | default(value="unimplemented!()") }}
    }
{% else %}
    fn {{ method.name }}(
        &self,
{% for param in method.params | default(value=[]) %}
{% if param.is_ref | default(value=false) %}
        {{ param.name }}: &{{ param.type }},
{% else %}
        {{ param.name }}: {{ param.type }},
{% endif %}
{% endfor %}
{% if method.return_wrap | default(value="Result") == "Result" %}
    ) -> Result<{{ method.return_type | default(value="()") }}, {{ method.error_type | default(value="A2AError") }}>;
{% elif method.return_wrap == "Option" %}
    ) -> Option<{{ method.return_type | default(value="()") }}>;
{% elif method.return_wrap == "Vec" %}
    ) -> Vec<{{ method.return_type | default(value="()") }}>;
{% else %}
    ) -> {{ method.return_type | default(value="()") }};
{% endif %}
{% endif %}

{% endfor %}
}

{# ──────────────────────────── Async trait ──────────────────────────── #}
{% if trait.feature_gate %}
#[cfg(feature = "{{ trait.feature_gate }}")]
{% endif %}
#[async_trait]
/// {{ trait.async_description | default(value=trait.description) }}
pub trait {{ trait.async_name | default(value="Async" ~ trait.name) }}: Send + Sync{% if trait.supertraits | default(value=[]) | length > 0 %} + {{ trait.supertraits | join(sep=" + ") }}{% endif %} {
{% for method in trait.methods %}
    /// {{ method.description }}
{% if method.has_default | default(value=false) %}
    async fn {{ method.name }}<'a>(
        &self,
{% for param in method.params | default(value=[]) %}
{% if param.is_ref | default(value=false) %}
{% if param.has_lifetime | default(value=true) %}
        {{ param.name }}: &'a {{ param.type }},
{% else %}
        {{ param.name }}: &{{ param.type }},
{% endif %}
{% else %}
        {{ param.name }}: {{ param.type }},
{% endif %}
{% endfor %}
{% if method.return_wrap | default(value="Result") == "Result" %}
    ) -> Result<{{ method.return_type | default(value="()") }}, {{ method.error_type | default(value="A2AError") }}> {
{% elif method.return_wrap == "Option" %}
    ) -> Option<{{ method.return_type | default(value="()") }}> {
{% elif method.return_wrap == "Vec" %}
    ) -> Vec<{{ method.return_type | default(value="()") }}> {
{% else %}
    ) -> {{ method.return_type | default(value="()") }} {
{% endif %}
        {{ method.default_body | default(value="unimplemented!()") }}
    }
{% else %}
    async fn {{ method.name }}<'a>(
        &self,
{% for param in method.params | default(value=[]) %}
{% if param.is_ref | default(value=false) %}
{% if param.has_lifetime | default(value=true) %}
        {{ param.name }}: &'a {{ param.type }},
{% else %}
        {{ param.name }}: &{{ param.type }},
{% endif %}
{% else %}
        {{ param.name }}: {{ param.type }},
{% endif %}
{% endfor %}
{% if method.return_wrap | default(value="Result") == "Result" %}
    ) -> Result<{{ method.return_type | default(value="()") }}, {{ method.error_type | default(value="A2AError") }}>;
{% elif method.return_wrap == "Option" %}
    ) -> Option<{{ method.return_type | default(value="()") }}>;
{% elif method.return_wrap == "Vec" %}
    ) -> Vec<{{ method.return_type | default(value="()") }}>;
{% else %}
    ) -> {{ method.return_type | default(value="()") }};
{% endif %}
{% endif %}

{% endfor %}
}

{# ──────────────────── Supporting types for this trait ──────────────────── #}
{% for stype in trait.supporting_types | default(value=[]) %}
{% if stype.description %}
/// {{ stype.description }}
{% endif %}
{% if stype.derives | default(value=[]) | length > 0 %}
#[derive({{ stype.derives | join(sep=", ") }})]
{% endif %}
{% if stype.kind == "enum" %}
pub enum {{ stype.name }} {
{% for variant in stype.variants | default(value=[]) %}
{% if variant.inner %}
    {{ variant.name }}({{ variant.inner }}),
{% else %}
    {{ variant.name }},
{% endif %}
{% endfor %}
}
{% elif stype.kind == "struct" %}
pub struct {{ stype.name }} {
{% for field in stype.fields | default(value=[]) %}
{% if field.description %}
    /// {{ field.description }}
{% endif %}
    pub {{ field.name }}: {{ field.type }},
{% endfor %}
}
{% endif %}

{% endfor %}
{% endfor %}
