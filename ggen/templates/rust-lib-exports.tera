---
# rust-lib-exports.tera - Generates lib.rs re-export declarations
#
# Expected SPARQL CONSTRUCT result variables:
#   top_level_modules: list of top-level module declarations (domain, port, adapter, etc.)
#   domain_exports: list of type names re-exported from the domain layer
#   port_exports: list of trait names re-exported from the port layer
#   feature_gated_exports: list of objects for conditional re-exports, each with:
#     - feature: the cargo feature flag (e.g., "http-client", "ws-server")
#     - module: source module path (e.g., "adapter")
#     - types: list of type names to re-export
#   compound_feature_exports: list of objects for multi-feature re-exports, each with:
#     - features: list of feature flags combined with any/all
#     - combinator: "any" or "all" (default: "all")
#     - module: source module path
#     - types: list of type names to re-export
#
# Template variables:
#   crate_name: name of the crate (e.g., "a2a_rs")
#   protocol_version: A2A protocol version (e.g., "0.3.0")
#   doc_summary: one-line crate summary
#   doc_description: extended crate documentation (multi-line)
#   top_level_modules: list of top-level module descriptors
#   domain_exports: flat list of domain type names
#   port_exports: flat list of port trait names
#   feature_gated_exports: list of feature-gated export groups
#   compound_feature_exports: list of multi-feature-gated export groups
---
//! {{ doc_summary }}
//!
{% for line in doc_description %}
//! {{ line }}
{% endfor %}
//!
//! A2A Protocol v{{ protocol_version }}
//! Generated by ggen from RDF ontology - DO NOT EDIT

// Top-level module declarations
{% for module in top_level_modules %}
{% if module.feature_gate is defined %}
#[cfg(feature = "{{ module.feature_gate }}")]
{% endif %}
pub mod {{ module.name }};
{% endfor %}

// Public API exports - Domain types
pub use domain::{
{% for type_name in domain_exports %}
    {{ type_name }},
{% endfor %}
};

// Port traits for separation of concerns
pub use port::{
{% for trait_name in port_exports %}
    {{ trait_name }},
{% endfor %}
};
{% if feature_gated_exports is defined %}

// Feature-gated adapter re-exports
{% for group in feature_gated_exports %}
#[cfg(feature = "{{ group.feature }}")]
{% if group.types | length == 1 %}
pub use {{ group.module }}::{{ group.types | first }};
{% else %}
pub use {{ group.module }}::{
{% for type_name in group.types %}
    {{ type_name }},
{% endfor %}
};
{% endif %}

{% endfor %}
{% endif %}
{% if compound_feature_exports is defined %}
// Compound feature-gated re-exports
{% for group in compound_feature_exports %}
#[cfg({{ group.combinator | default(value="all") }}({% for f in group.features %}feature = "{{ f }}"{% if not loop.last %}, {% endif %}{% endfor %}))]
{% if group.types | length == 1 %}
pub use {{ group.module }}::{{ group.types | first }};
{% else %}
pub use {{ group.module }}::{
{% for type_name in group.types %}
    {{ type_name }},
{% endfor %}
};
{% endif %}

{% endfor %}
{% endif %}
