---
output_file: builders.rs
description: >
  Generates bon::Builder derive macros and builder helper functions for
  A2A Protocol domain types with 3+ fields. Follows project conventions
  for optional fields, defaults, and validation.
variables:
  types: >
    Array of type descriptors filtered to those with 3+ fields that should
    have builders, extracted from SPARQL CONSTRUCT results.
---
{# ============================================================================
   builders.rs.tera
   ============================================================================
   Tera template for generating bon::Builder configurations for domain types.

   Per project conventions, types with 3+ fields should derive bon::Builder
   with appropriate defaults and optional field handling.

   Expected context variables:
   - types: array of type descriptors, each containing:
       - name:           String  -- Rust type name (e.g. "AgentCard")
       - description:    String? -- Documentation
       - field_count:    int     -- Number of fields (filtered to >= 3)
       - fields: array of field descriptors, each containing:
           - name:          String  -- Rust field name
           - rust_type:     String  -- Rust type
           - is_optional:   bool    -- Whether wrapped in Option<T>
           - is_vec:        bool    -- Whether wrapped in Vec<T>
           - default_value: String? -- Default expression for builder
           - description:   String? -- Field documentation
   ============================================================================
#}
//! Auto-generated builder configurations for A2A Protocol domain types.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.
//!
//! These builder helpers provide ergonomic construction of domain types
//! following the bon::Builder pattern.

use bon::Builder;
use serde::{Deserialize, Serialize};

{% for type in types %}
{# --------------------------------------------------------------------------
   Doc comment block
   -------------------------------------------------------------------------- #}
{% if type.description %}
/// {{ type.description | split(pat="\n") | first }}
{% for line in type.description | split(pat="\n") %}
{% if not loop.first %}
/// {{ line }}
{% endif %}
{% endfor %}
///
{% endif %}
/// Builder pattern enabled with {{ type.field_count }} fields.
///
/// # Example
///
/// ```
/// use a2a_rs::{{ type.name }};
///
/// let instance = {{ type.name }}::builder()
{% for field in type.fields %}
{% if not field.is_optional and not field.default_value %}
///     .{{ field.name }}({{ field.name }}_value)
{% endif %}
{% endfor %}
///     .build();
/// ```
#[derive(Debug, Clone, Serialize, Deserialize, Builder)]
#[serde(rename_all = "camelCase")]
pub struct {{ type.name }} {
{% for field in type.fields %}
{# --------------------------------------------------------------------------
   Field documentation
   -------------------------------------------------------------------------- #}
{% if field.description %}
    /// {{ field.description | split(pat="\n") | first }}
{% endif %}
{# --------------------------------------------------------------------------
   Serde attributes
   -------------------------------------------------------------------------- #}
{% if field.is_optional %}
    #[serde(skip_serializing_if = "Option::is_none")]
{% endif %}
{% if field.default_value %}
    #[serde(default = "{{ type.name }}::default_{{ field.name }}")]
{% endif %}
{# --------------------------------------------------------------------------
   Builder attributes
   -------------------------------------------------------------------------- #}
{% if field.default_value %}
    #[builder(default = Self::default_{{ field.name }}())]
{% elif field.is_optional %}
    #[builder(default)]
{% elif field.is_vec %}
    #[builder(default)]
{% endif %}
{# --------------------------------------------------------------------------
   Field declaration
   -------------------------------------------------------------------------- #}
{% if field.is_optional and field.is_vec %}
    pub {{ field.name }}: Option<Vec<{{ field.rust_type }}>>,
{% elif field.is_optional %}
    pub {{ field.name }}: Option<{{ field.rust_type }}>,
{% elif field.is_vec %}
    pub {{ field.name }}: Vec<{{ field.rust_type }}>,
{% else %}
    pub {{ field.name }}: {{ field.rust_type }},
{% endif %}
{% endfor %}
}

impl {{ type.name }} {
{% for field in type.fields %}
{% if field.default_value %}
    /// Default value for `{{ field.name }}` field.
{% if field.is_vec %}
    fn default_{{ field.name }}() -> Vec<{{ field.rust_type }}> {
        {{ field.default_value }}
    }
{% elif field.is_optional %}
    fn default_{{ field.name }}() -> Option<{{ field.rust_type }}> {
        Some({{ field.default_value }})
    }
{% else %}
    fn default_{{ field.name }}() -> {{ field.rust_type }} {
        {{ field.default_value }}
    }
{% endif %}

{% endif %}
{% endfor %}
    /// Create a new builder instance.
    pub fn builder() -> {{ type.name }}Builder {
        {{ type.name }}Builder::default()
    }
}

{% endfor %}

{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://ggen.io/ontology/a2a/>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

   CONSTRUCT {
       ?entity a a2a:GeneratedBuilder ;
           a2a:typeName ?name ;
           a2a:typeDoc ?doc ;
           a2a:fieldCount ?fieldCount ;
           a2a:hasField ?field .

       ?field a a2a:BuilderField ;
           a2a:fieldName ?fieldName ;
           a2a:rustType ?rustType ;
           a2a:isOptional ?optional ;
           a2a:isVec ?isVec ;
           a2a:defaultValue ?defaultVal ;
           a2a:description ?desc .
   }
   WHERE {
       # Only entities with 3+ fields should have builders
       ?entity a a2a:Entity ;
           a2a:name ?name ;
           a2a:hasProperty ?props .

       # Count fields
       {
           SELECT ?entity (COUNT(?p) AS ?fieldCount)
           WHERE {
               ?entity a2a:hasProperty ?p .
           }
           GROUP BY ?entity
           HAVING (COUNT(?p) >= 3)
       }

       OPTIONAL { ?entity rdfs:comment ?doc }

       ?entity a2a:hasProperty ?field .
       ?field a2a:name ?fieldName ;
           a2a:type ?xsdType .

       # Map to Rust types
       BIND(
           IF(?xsdType = xsd:string, "String",
           IF(?xsdType = xsd:boolean, "bool",
           IF(?xsdType = xsd:integer, "i64",
           IF(?xsdType = xsd:float, "f64",
           str(?xsdType)))))
           AS ?rustType
       )

       OPTIONAL { ?field a2a:optional ?optional }
       OPTIONAL { ?field a2a:isArray ?isVec }
       OPTIONAL { ?field a2a:default ?defaultVal }
       OPTIONAL { ?field rdfs:comment ?desc }
   }
   ORDER BY ?name ?fieldName
   ============================================================================
#}
