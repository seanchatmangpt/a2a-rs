---
description: >
  Generates Rust enum definitions from SPARQL CONSTRUCT query results
  for the A2A Protocol v0.3.0. Produces simple enums, tagged enums,
  and thiserror error enums from RDF enum values and class hierarchies.
input: sparql-construct
output: rust
---
{# ============================================================================
   rust-enums.tera
   ============================================================================
   Tera template for generating Rust enums from RDF/SPARQL CONSTRUCT results.

   Expected context variables:
   - enums: array of enum descriptors, each containing:
       - name:          String  -- Rust enum name (e.g. "TaskState")
       - description:   String  -- RDF rdfs:comment / doc comment text
       - serde_rename:  String? -- optional serde rename_all strategy
                                   (e.g. "kebab-case", "lowercase")
       - tag_field:     String? -- if present, generates #[serde(tag = "...")]
                                   for internally tagged enum representation
       - is_error:      bool    -- if true, generates a thiserror error enum
       - extra_derives: array?  -- additional derive traits beyond the defaults
       - variants: array of variant descriptors, each containing:
           - name:         String  -- Rust variant name (e.g. "InputRequired")
           - description:  String  -- RDF description for doc comment
           - rename:       String? -- serde rename value for this variant
           - error_code:   i32?    -- JSON-RPC / A2A error code (for error enums)
           - error_msg:    String? -- default error message (for error enums)
           - fields:       array?  -- struct variant fields, each containing:
               - name:          String  -- field name
               - type:          String  -- Rust type
               - description:   String? -- doc comment for the field
               - serde_rename:  String? -- serde rename for this field
               - skip_none:     bool?   -- if true, adds skip_serializing_if
   ============================================================================
#}
//! Auto-generated Rust enum definitions from A2A Protocol RDF ontology.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.

use serde::{Deserialize, Serialize};
{% if has_error_enums %}
use thiserror::Error;
{% endif %}
{% if needs_serde_json %}
use serde_json::{Map, Value};
{% endif %}

{% for enum in enums %}
{# --------------------------------------------------------------------------
   Doc comment block from RDF description
   -------------------------------------------------------------------------- #}
{% if enum.description %}
/// {{ enum.description | split(pat="\n") | first }}
{% for line in enum.description | split(pat="\n") %}
{% if not loop.first %}
/// {{ line }}
{% endif %}
{% endfor %}
{% endif %}
{# --------------------------------------------------------------------------
   Derive and serde attributes
   -------------------------------------------------------------------------- #}
{% if enum.is_error %}
#[derive(Error, Debug, Clone)]
{% else %}
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq{% if enum.extra_derives %}, {{ enum.extra_derives | join(sep=", ") }}{% endif %})]
{% endif %}
{% if enum.serde_rename %}
#[serde(rename_all = "{{ enum.serde_rename }}")]
{% endif %}
{% if enum.tag_field %}
#[serde(tag = "{{ enum.tag_field }}")]
{% endif %}
pub enum {{ enum.name }} {
{% for variant in enum.variants %}
{# --------------------------------------------------------------------------
   Per-variant doc comment
   -------------------------------------------------------------------------- #}
{% if variant.description %}
    /// {{ variant.description | split(pat="\n") | first }}
{% for line in variant.description | split(pat="\n") %}
{% if not loop.first %}
    /// {{ line }}
{% endif %}
{% endfor %}
{% endif %}
{# --------------------------------------------------------------------------
   Error variant with thiserror #[error(...)] attribute
   -------------------------------------------------------------------------- #}
{% if enum.is_error and variant.error_msg %}
    #[error("{{ variant.error_msg }}")]
{% elif enum.is_error and variant.error_fmt %}
    #[error("{{ variant.error_fmt }}")]
{% endif %}
{# --------------------------------------------------------------------------
   Serde rename for individual variant
   -------------------------------------------------------------------------- #}
{% if variant.rename %}
    #[serde(rename = "{{ variant.rename }}")]
{% endif %}
{# --------------------------------------------------------------------------
   Variant body: unit, tuple, or struct
   -------------------------------------------------------------------------- #}
{% if variant.fields %}
    {{ variant.name }} {
{% for field in variant.fields %}
{% if field.description %}
        /// {{ field.description }}
{% endif %}
{% if field.serde_rename %}
        #[serde(rename = "{{ field.serde_rename }}")]
{% endif %}
{% if field.skip_none %}
        #[serde(skip_serializing_if = "Option::is_none")]
{% endif %}
        {{ field.name }}: {{ field.type }},
{% endfor %}
    },
{% elif variant.tuple_type %}
    {{ variant.name }}({{ variant.tuple_type }}),
{% else %}
    {{ variant.name }},
{% endif %}
{% endfor %}
}

{% endfor %}
{# ============================================================================
   Error code constants block
   ============================================================================
   Generates associated constants for JSON-RPC and A2A-specific error codes
   when error_enums are present.
   -------------------------------------------------------------------------- #}
{% if error_codes %}
/// Standard JSON-RPC error codes
{% for code in error_codes %}
{% if code.description %}
/// {{ code.description }}
{% endif %}
pub const {{ code.name }}: i32 = {{ code.value }};
{% endfor %}
{% endif %}
{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://schemas.a2aprotocol.ai/ontology/>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

   CONSTRUCT {
     ?enum   a a2a:EnumType ;
             rdfs:label      ?enumName ;
             rdfs:comment    ?enumDesc ;
             a2a:serdeRename ?serdeRename ;
             a2a:tagField    ?tagField ;
             a2a:hasVariant  ?variant .

     ?variant a a2a:EnumVariant ;
              rdfs:label     ?variantName ;
              rdfs:comment   ?variantDesc ;
              a2a:rdfValue   ?rdfValue ;
              a2a:errorCode  ?errorCode ;
              a2a:errorMsg   ?errorMsg .
   }
   WHERE {
     ?enum   a a2a:EnumType ;
             rdfs:label      ?enumName .
     OPTIONAL { ?enum rdfs:comment    ?enumDesc }
     OPTIONAL { ?enum a2a:serdeRename ?serdeRename }
     OPTIONAL { ?enum a2a:tagField    ?tagField }

     ?enum a2a:hasVariant ?variant .
     ?variant rdfs:label ?variantName .
     OPTIONAL { ?variant rdfs:comment  ?variantDesc }
     OPTIONAL { ?variant a2a:rdfValue  ?rdfValue }
     OPTIONAL { ?variant a2a:errorCode ?errorCode }
     OPTIONAL { ?variant a2a:errorMsg  ?errorMsg }
   }

   Expected RDF graph data (Turtle) for A2A enums:

   a2a:TaskState a a2a:EnumType ;
       rdfs:label      "TaskState" ;
       rdfs:comment    "Represents the possible states of a Task." ;
       a2a:serdeRename "kebab-case" ;
       a2a:hasVariant  a2a:TaskState_Submitted ,
                       a2a:TaskState_Working ,
                       a2a:TaskState_InputRequired ,
                       a2a:TaskState_Completed ,
                       a2a:TaskState_Canceled ,
                       a2a:TaskState_Failed ,
                       a2a:TaskState_Rejected ,
                       a2a:TaskState_AuthRequired ,
                       a2a:TaskState_Unknown .

   a2a:TaskState_Submitted a a2a:EnumVariant ;
       rdfs:label    "Submitted" ;
       rdfs:comment  "Task has been received and is queued for processing" ;
       a2a:rdfValue  "submitted" .

   a2a:Part a a2a:EnumType ;
       rdfs:label   "Part" ;
       rdfs:comment "Parts that can make up a message (text, file, or structured data)." ;
       a2a:tagField "kind" ;
       a2a:hasVariant a2a:Part_Text , a2a:Part_File , a2a:Part_Data .

   a2a:Part_Text a a2a:EnumVariant ;
       rdfs:label   "Text" ;
       rdfs:comment "Plain text content with optional metadata" ;
       a2a:rdfValue "text" .

   ============================================================================ #}
