---
output_file: domain_structs.rs
description: >
  Generates Rust struct definitions from SPARQL CONSTRUCT query results
  for the A2A Protocol v0.3.0 domain types. Produces structs with serde
  serialization, bon builders, optional fields, and doc comments derived
  from RDF descriptions in the ontology.
variables:
  structs: >
    Array of struct descriptors extracted from SPARQL CONSTRUCT results,
    each containing name, description, and fields with type mappings.
  needs_chrono: >
    Boolean flag indicating whether any field uses chrono::DateTime<Utc>,
    triggering a chrono import.
  needs_url: >
    Boolean flag indicating whether any field uses url::Url,
    triggering a url import.
  needs_builder: >
    Boolean flag indicating whether any struct has 3+ fields,
    triggering a bon::Builder import.
  needs_hashmap: >
    Boolean flag indicating whether any field uses HashMap,
    triggering a std::collections::HashMap import.
  needs_serde_json: >
    Boolean flag indicating whether any field uses serde_json types,
    triggering a serde_json import.
---
{# ============================================================================
   rust-domain-structs.tera
   ============================================================================
   Tera template for generating Rust structs from RDF/SPARQL CONSTRUCT results.

   This template is driven by the domain-structs rule in ggen.toml, whose
   CONSTRUCT query transforms the A2A RDF ontology into an intermediate graph
   of GeneratedStruct and StructField resources with Rust type mappings.

   Expected context variables:
   - structs: array of struct descriptors, each containing:
       - name:           String  -- Rust struct name (e.g. "AgentCard")
       - description:    String? -- RDF rdfs:comment / doc comment text
       - use_builder:    bool    -- if true, derives bon::Builder (3+ fields)
       - extra_derives:  array?  -- additional derive traits beyond defaults
       - serde_rename_all: String? -- serde rename_all strategy
                                      (default: "camelCase")
       - fields: array of field descriptors, each containing:
           - name:          String  -- Rust field name in snake_case
           - rust_type:     String  -- mapped Rust type from XSD/ontology type
           - description:   String? -- RDF description for doc comment
           - is_optional:   bool    -- if true, wraps type in Option<T>
           - is_vec:        bool    -- if true, wraps type in Vec<T>
           - serde_rename:  String? -- serde rename value (JSON field name)
           - default_value: String? -- default expression for #[serde(default)]
                                       and #[builder(default)]
           - skip_none:     bool?   -- if true, adds
                                       #[serde(skip_serializing_if = "Option::is_none")]

   XSD to Rust type mapping (applied in the CONSTRUCT query BIND):
     xsd:string    -> String
     xsd:integer   -> i64
     xsd:boolean   -> bool
     xsd:dateTime  -> chrono::DateTime<Utc>
     xsd:anyURI    -> url::Url
     xsd:float     -> f64
     a2a:JsonValue -> serde_json::Value
     a2a:JsonMap   -> serde_json::Map<String, serde_json::Value>
     Other         -> resolved from ontology class name
   ============================================================================
#}
//! Auto-generated Rust struct definitions from A2A Protocol RDF ontology.
//!
//! This file is generated by ggen from SPARQL CONSTRUCT query results.
//! Do not edit manually; re-run the generator to update.
//!
//! Type mapping from XSD/RDF to Rust:
//!   xsd:string    -> String
//!   xsd:integer   -> i64
//!   xsd:boolean   -> bool
//!   xsd:dateTime  -> chrono::DateTime<Utc>
//!   xsd:anyURI    -> url::Url
//!   xsd:float     -> f64

use serde::{Deserialize, Serialize};
{% if needs_builder %}
use bon::Builder;
{% endif %}
{% if needs_chrono %}
use chrono::{DateTime, Utc};
{% endif %}
{% if needs_url %}
use url::Url;
{% endif %}
{% if needs_hashmap %}
use std::collections::HashMap;
{% endif %}
{% if needs_serde_json %}
use serde_json::{Map, Value};
{% endif %}

{% for struct in structs %}
{# --------------------------------------------------------------------------
   Doc comment block from RDF description
   -------------------------------------------------------------------------- #}
{% if struct.description %}
/// {{ struct.description | split(pat="\n") | first }}
{% for line in struct.description | split(pat="\n") %}
{% if not loop.first %}
/// {{ line }}
{% endif %}
{% endfor %}
{% endif %}
{# --------------------------------------------------------------------------
   Derive and attribute block
   -------------------------------------------------------------------------- #}
{% if struct.use_builder %}
#[derive(Debug, Clone, Serialize, Deserialize, Builder{% if struct.extra_derives %}, {{ struct.extra_derives | join(sep=", ") }}{% endif %})]
{% else %}
#[derive(Debug, Clone, Serialize, Deserialize{% if struct.extra_derives %}, {{ struct.extra_derives | join(sep=", ") }}{% endif %})]
{% endif %}
{% if struct.serde_rename_all %}
#[serde(rename_all = "{{ struct.serde_rename_all }}")]
{% else %}
#[serde(rename_all = "camelCase")]
{% endif %}
pub struct {{ struct.name }} {
{% for field in struct.fields %}
{# --------------------------------------------------------------------------
   Per-field doc comment
   -------------------------------------------------------------------------- #}
{% if field.description %}
    /// {{ field.description | split(pat="\n") | first }}
{% for line in field.description | split(pat="\n") %}
{% if not loop.first %}
    /// {{ line }}
{% endif %}
{% endfor %}
{% endif %}
{# --------------------------------------------------------------------------
   Serde attributes for the field
   -------------------------------------------------------------------------- #}
{% if field.is_optional and field.serde_rename %}
    #[serde(skip_serializing_if = "Option::is_none", rename = "{{ field.serde_rename }}")]
{% elif field.is_optional %}
    #[serde(skip_serializing_if = "Option::is_none")]
{% elif field.serde_rename and field.default_value %}
    #[serde(default = "{{ field.default_value }}", rename = "{{ field.serde_rename }}")]
{% elif field.serde_rename %}
    #[serde(rename = "{{ field.serde_rename }}")]
{% elif field.default_value %}
    #[serde(default = "{{ field.default_value }}")]
{% endif %}
{# --------------------------------------------------------------------------
   Builder default attribute (only when struct uses builder)
   -------------------------------------------------------------------------- #}
{% if struct.use_builder and field.default_value %}
    #[builder(default = {{ field.default_value }}())]
{% endif %}
{# --------------------------------------------------------------------------
   Field declaration with proper type wrapping
   -------------------------------------------------------------------------- #}
{% if field.is_optional and field.is_vec %}
    pub {{ field.name }}: Option<Vec<{{ field.rust_type }}>>,
{% elif field.is_optional %}
    pub {{ field.name }}: Option<{{ field.rust_type }}>,
{% elif field.is_vec %}
    pub {{ field.name }}: Vec<{{ field.rust_type }}>,
{% else %}
    pub {{ field.name }}: {{ field.rust_type }},
{% endif %}
{% endfor %}
}

{% endfor %}
{# ============================================================================
   Example SPARQL CONSTRUCT query for populating this template:

   PREFIX a2a:  <https://ggen.io/ontology/a2a/>
   PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

   CONSTRUCT {
     ?entity a a2a:GeneratedStruct ;
         a2a:structName ?name ;
         a2a:structDoc ?entityDoc ;
         a2a:hasField ?prop .

     ?prop a a2a:StructField ;
         a2a:fieldName ?propName ;
         a2a:fieldType ?rustType ;
         a2a:isRequired ?required ;
         a2a:isOptional ?optional ;
         a2a:isVec ?isVec ;
         a2a:description ?desc ;
         a2a:hasDefault ?defaultVal ;
         a2a:serdeRename ?jsonName ;
         a2a:fieldOrder ?order .
   }
   WHERE {
     ?entity a a2a:Entity ;
         a2a:name ?name .

     OPTIONAL { ?entity rdfs:comment ?entityDoc }

     ?entity a2a:hasProperty ?prop .
     ?prop a2a:name ?propName ;
         a2a:type ?type .

     # Map XSD / ontology types to Rust types
     BIND(
         IF(?type = xsd:string, "String",
         IF(?type = xsd:boolean, "bool",
         IF(?type = xsd:integer, "i64",
         IF(?type = xsd:float, "f64",
         IF(?type = xsd:dateTime, "chrono::DateTime<Utc>",
         IF(?type = xsd:anyURI, "url::Url",
         IF(?type = a2a:JsonValue, "serde_json::Value",
         IF(?type = a2a:JsonMap, "serde_json::Map<String, serde_json::Value>",
         str(?type)))))))))
         AS ?rustType
     )

     OPTIONAL { ?prop a2a:required ?required }
     OPTIONAL {
         ?prop a2a:required ?req .
         BIND(IF(!?req, true, false) AS ?optional)
     }
     OPTIONAL { ?prop a2a:isArray ?isVec }
     OPTIONAL { ?prop rdfs:comment ?desc }
     OPTIONAL { ?prop a2a:default ?defaultVal }
     OPTIONAL { ?prop a2a:jsonName ?jsonName }
     OPTIONAL { ?prop a2a:order ?order }
   }

   Expected RDF graph data (Turtle) for A2A structs:

   a2a:AgentProvider a a2a:Entity ;
       rdfs:comment "Information about an agent provider." ;
       a2a:name "AgentProvider" ;
       a2a:hasProperty a2a:AgentProvider_organization ,
                       a2a:AgentProvider_url .

   a2a:AgentProvider_organization a2a:name "organization" ;
       a2a:type xsd:string ;
       a2a:required true ;
       rdfs:comment "The name of the agent provider's organization." ;
       a2a:order 1 .

   a2a:AgentProvider_url a2a:name "url" ;
       a2a:type xsd:string ;
       a2a:required true ;
       rdfs:comment "The provider's website URL." ;
       a2a:order 2 .

   a2a:TaskStatus a a2a:Entity ;
       rdfs:comment "Status of a task including state, optional message, and timestamp." ;
       a2a:name "TaskStatus" ;
       a2a:hasProperty a2a:TaskStatus_state ,
                       a2a:TaskStatus_message ,
                       a2a:TaskStatus_timestamp .

   a2a:TaskStatus_state a2a:name "state" ;
       a2a:type a2a:TaskState ;
       a2a:required true ;
       rdfs:comment "The current state of the task's lifecycle." ;
       a2a:order 1 .

   a2a:TaskStatus_message a2a:name "message" ;
       a2a:type a2a:Message ;
       a2a:required false ;
       rdfs:comment "An optional message providing details about the status." ;
       a2a:order 2 .

   a2a:TaskStatus_timestamp a2a:name "timestamp" ;
       a2a:type xsd:dateTime ;
       a2a:required false ;
       rdfs:comment "ISO 8601 datetime when this status was recorded." ;
       a2a:order 3 .

   a2a:AgentCard a a2a:Entity ;
       rdfs:comment "Card describing an agent's capabilities, metadata, and skills." ;
       a2a:name "AgentCard" ;
       a2a:hasProperty a2a:AgentCard_name ,
                       a2a:AgentCard_description ,
                       a2a:AgentCard_url ,
                       a2a:AgentCard_version ,
                       a2a:AgentCard_protocolVersion ,
                       a2a:AgentCard_capabilities ,
                       a2a:AgentCard_skills .

   a2a:AgentCard_name a2a:name "name" ;
       a2a:type xsd:string ;
       a2a:required true ;
       rdfs:comment "The agent's human-readable name." ;
       a2a:order 1 .

   a2a:AgentCard_description a2a:name "description" ;
       a2a:type xsd:string ;
       a2a:required true ;
       rdfs:comment "A description of the agent's purpose." ;
       a2a:order 2 .

   a2a:AgentCard_url a2a:name "url" ;
       a2a:type xsd:string ;
       a2a:required true ;
       rdfs:comment "The preferred endpoint URL for the agent." ;
       a2a:order 3 .

   a2a:AgentCard_version a2a:name "version" ;
       a2a:type xsd:string ;
       a2a:required true ;
       rdfs:comment "The agent's version number." ;
       a2a:order 4 .

   a2a:AgentCard_protocolVersion a2a:name "protocol_version" ;
       a2a:type xsd:string ;
       a2a:required true ;
       a2a:jsonName "protocolVersion" ;
       a2a:default "default_protocol_version" ;
       rdfs:comment "The A2A protocol version. Defaults to '0.3.0'." ;
       a2a:order 5 .

   a2a:AgentCard_capabilities a2a:name "capabilities" ;
       a2a:type a2a:AgentCapabilities ;
       a2a:required true ;
       rdfs:comment "Capabilities supported by the agent." ;
       a2a:order 6 .

   a2a:AgentCard_skills a2a:name "skills" ;
       a2a:type a2a:AgentSkill ;
       a2a:required true ;
       a2a:isArray true ;
       rdfs:comment "Skills the agent can perform." ;
       a2a:order 7 .

   ============================================================================ #}
